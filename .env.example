# Local development settings for touchline-api.
# Copy this file to .env (gitignored) and fill in the real values. Never commit .env.
# Double underscores map to config sections: ConnectionStrings__Touchline -> ConnectionStrings:Touchline.
# Real environment variables override anything in .env.

# Supabase Postgres via the transaction pooler (port 6543), connecting as app_api_user.
ConnectionStrings__Touchline="Host=aws-0-eu-west-3.pooler.supabase.com;Port=6543;Database=postgres;Username=app_api_user.<project-ref>;Password=<from password manager>;SSL Mode=Require"

# Supabase project URL (used to validate access tokens).
Supabase__Url=https://<project-ref>.supabase.co

# Only if the project still signs tokens with the legacy shared JWT secret.
# Supabase__JwtSecret=

# ---- Hosting (Railway, staging, production) ----------------------------------------------------------
# Startup refuses to run in Staging/Production unless these are set (StartupValidation in Operations.cs):
#   ConnectionStrings__Touchline   with "SSL Mode=Require" and Username app_api_user (never postgres or the worker)
#   Supabase__Url                  https://<project>.supabase.co
#   Cors__AllowedOrigins__0        the web app's https origin, e.g. https://app.example.com (add __1, __2 … for more)
# ASPNETCORE_ENVIRONMENT=Production   (the Docker image sets this; use Staging for staging)
# PORT=8080                           (the app listens on PORT, else 8080; the Railway domain must target the same port)
# StagingKit__Enabled must not be true in Production. OpenApi__Expose=true shows /openapi/v1.json outside Development.

# Only for scripts/api-health-check.ps1 (signed-in checks): the Supabase PUBLISHABLE key (sb_publishable_...).
# Never put the secret / service_role key here.
# SUPABASE_PUBLISHABLE_KEY=
