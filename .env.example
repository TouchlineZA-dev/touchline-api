# Local development settings for touchline-api.
# Copy this file to .env (gitignored) and fill in the real values. Never commit .env.
# Double underscores map to config sections: ConnectionStrings__Touchline -> ConnectionStrings:Touchline.
# Real environment variables override anything in .env.

# Supabase Postgres via the transaction pooler (port 6543), connecting as app_api_user.
ConnectionStrings__Touchline="Host=aws-0-eu-west-3.pooler.supabase.com;Port=6543;Database=postgres;Username=app_api_user.<project-ref>;Password=<from password manager>;SSL Mode=Require"

# Supabase project URL (used to validate access tokens).
Supabase__Url=https://<project-ref>.supabase.co

# Only if the project still signs tokens with the legacy shared JWT secret.
# Supabase__JwtSecret=
